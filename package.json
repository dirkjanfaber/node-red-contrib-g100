{
  "name": "node-red-contrib-g100",
  "version": "0.2.0",
  "description": "Node-RED node for G100/2 export and import limitation compliance (UK)",
  "keywords": [
    "node-red",
    "victron",
    "g100",
    "g100-2",
    "export-limitation",
    "import-limitation",
    "cls",
    "uk",
    "energy",
    "grid-compliance"
  ],
  "author": "Dirk-Jan Faber",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dirkjanfaber/node-red-contrib-g100.git"
  },
  "main": "dist/nodes/g100.js",
  "files": [
    "dist/",
    "locales/",
    "examples/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsc && cp src/nodes/*.html dist/nodes/",
    "build:watch": "tsc --watch",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "node-red": {
    "version": ">=2.0.0",
    "nodes": {
      "g100": "dist/nodes/g100.js"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "eslint": "^10.4.1",
    "jest": "^30.0.0",
    "ts-jest": "^29.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0"
  },
  "peerDependencies": {
    "node-red": ">=2.0.0 <5.0.0"
  }
}
